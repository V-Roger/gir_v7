# Copy to .env and fill with values from https://sanity.io/manage (Project → API).
# Project ID must be lowercase letters, numbers, and dashes only (no underscores).
# Until these are set, the site builds using a dummy project id and shows empty CMS content.

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# --- Optional: auto-rebuild on Netlify when you publish in Sanity ---
# 1. Netlify: Site settings → Build & deploy → Build hooks → Add hook → copy URL.
# 2. Sanity: sanity.io/manage → your project → API → Webhooks → Create webhook:
#    - URL: paste the Netlify build hook URL
#    - Trigger on: Create, update, delete (or as you prefer)
#    - Dataset: production (or match PUBLIC_SANITY_DATASET)
# 3. No secret required for a simple build hook URL (treat the URL as private).
