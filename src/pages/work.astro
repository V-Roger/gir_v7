---
import SanityImage from "../components/SanityImage.astro";
import Layout from "../layouts/Layout.astro";
import { getSiteSettings, homeTitleOf, sanityFetch, siteTitleOf } from "../lib/sanity/fetch";
import { imageAttrs } from "../lib/sanity/image";
import { GALLERIES_INDEX_QUERY } from "../lib/sanity/queries";
import type { GalleryIndexItem } from "../lib/sanity/types";

const [settings, galleries] = await Promise.all([
  getSiteSettings(),
  sanityFetch<GalleryIndexItem[]>(GALLERIES_INDEX_QUERY, []),
]);

const PREVIEW_SIZES = "(min-width: 1280px) 50vw, 100vw";

const defaultGallery = galleries.find((g) => g.cover?.image) ?? galleries[0];
const defaultCover = defaultGallery?.cover?.image;
---

<Layout title={homeTitleOf(settings)} siteTitle={siteTitleOf(settings)} description={settings?.tagline}>
  <section class="w-full h-full pt-12 px-4 xl:px-12 flex flex-nowrap items-center flex-col xl:flex-row gap-12 overflow-y-auto">
    <aside class="w-full h-full xl:w-1/2 flex flex-col gap-8 overflow-y-auto pt-20 pb-12 pr-8">
      <ul class="flex flex-col items-end gap-6 text-3xl font-medium">
        {
          galleries.map((gallery) => {
            const preview = gallery.cover?.image
              ? imageAttrs(gallery.cover.image, { sizes: PREVIEW_SIZES })
              : undefined;
            return (
              <li class="text-right">
                <a
                  href={`/galleries/${gallery.slug}`}
                  class="work-gallery-preview-trigger transition hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
                  data-preview-src={preview?.src}
                  data-preview-srcset={preview?.srcset}
                  data-preview-width={preview?.width}
                  data-preview-height={preview?.height}
                  data-preview-alt={gallery.cover?.alt ?? gallery.title}
                >
                  {gallery.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </aside>
    <section class="w-full h-full xl:overflow-y-auto pb-4 pt-12 flex flex-col gap-8">
      {
        defaultGallery && (
          <a
            id="work-preview-link"
            href={`/galleries/${defaultGallery.slug}`}
            class="block h-full w-full min-h-[40vh] xl:min-h-0"
            aria-label={`Ouvrir la série : ${defaultGallery.title}`}
          >
            <figure class="h-full w-full flex flex-col items-center justify-center">
              {defaultCover && (
                <SanityImage
                  id="work-preview-image"
                  image={defaultCover}
                  alt={defaultGallery.cover?.alt ?? defaultGallery.title}
                  sizes={PREVIEW_SIZES}
                  priority
                  class="max-h-full max-w-full object-contain"
                />
              )}
            </figure>
          </a>
        )
      }
    </section>
  </section>
</Layout>

<script>
  const img = document.getElementById("work-preview-image") as HTMLImageElement | null;
  const link = document.getElementById("work-preview-link") as HTMLAnchorElement | null;

  function apply(trigger: HTMLAnchorElement) {
    if (!img || !link) return;
    link.href = trigger.href;
    const title = trigger.textContent?.trim();
    if (title) link.setAttribute("aria-label", `Ouvrir la série : ${title}`);

    const { previewSrc, previewSrcset, previewWidth, previewHeight, previewAlt } = trigger.dataset;
    if (!previewSrc || img.getAttribute("src") === previewSrc) return;
    // Set srcset before src so the browser picks the right candidate in one request.
    if (previewSrcset) img.srcset = previewSrcset;
    img.src = previewSrc;
    if (previewWidth) img.width = Number(previewWidth);
    if (previewHeight) img.height = Number(previewHeight);
    img.alt = previewAlt ?? "";
  }

  document.querySelectorAll<HTMLAnchorElement>(".work-gallery-preview-trigger").forEach((el) => {
    el.addEventListener("mouseenter", () => apply(el));
    el.addEventListener("focus", () => apply(el));
  });
</script>
