---
import SanityImage from "../components/SanityImage.astro";
import Layout from "../layouts/Layout.astro";
import { getSiteSettings, homeTitleOf, siteTitleOf } from "../lib/sanity/fetch";

const settings = await getSiteSettings();
const siteTitle = siteTitleOf(settings);
---

<Layout title={homeTitleOf(settings)} siteTitle={siteTitle} description={settings?.tagline}>
  {
    settings?.cover && (
      <figure class="h-full w-full flex flex-col items-center justify-center xl:items-end p-4 xl:p-40">
        <SanityImage
          image={settings.cover}
          alt={settings.coverAlt ?? siteTitle}
          sizes="(min-width: 1280px) calc(100vw - 20rem), calc(100vw - 2rem)"
          priority
          class="max-h-full max-w-full object-contain"
        />
      </figure>
    )
  }
</Layout>
