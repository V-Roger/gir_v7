---
import Layout from "../layouts/Layout.astro";
import { urlFor } from "../lib/sanity/image";
import { SITE_SETTINGS_QUERY } from "../lib/sanity/queries";
import type { SiteSettings } from "../lib/sanity/types";
import { sanityClient } from "sanity:client";

let settings: SiteSettings | null = null;

try {
  settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);
} catch (err) {
  console.warn("Sanity fetch failed — check PUBLIC_SANITY_PROJECT_ID and dataset.", err);
}

const siteTitle = settings?.title ?? "Portfolio";
const pageTitle = settings?.tagline ? `${siteTitle} — ${settings.tagline}` : siteTitle;
---

<Layout title={pageTitle} siteTitle={siteTitle} description={settings?.tagline}>
  {settings?.cover?.image ? (
    <figure class="h-full w-full flex flex-col items-center justify-center xl:items-end p-4 xl:p-40">
      <img
        src={urlFor(settings.cover.image).fit("max").auto("format").url()}
        alt={settings.cover.alt ?? "Virgil ROGER"}
        loading="lazy"
        decoding="async"
        class="max-h-full max-w-full object-contain"
      />
    </figure>
  ) : null}  
</Layout>
