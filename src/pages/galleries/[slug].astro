---
import type { GetStaticPaths } from "astro";
import ExhibitionList from "../../components/ExhibitionList.astro";
import SanityImage from "../../components/SanityImage.astro";
import Layout from "../../layouts/Layout.astro";
import { renderMarkdown } from "../../lib/markdown";
import { getSiteSettings, sanityFetch, siteTitleOf } from "../../lib/sanity/fetch";
import { GALLERIES_DETAIL_QUERY } from "../../lib/sanity/queries";
import type { GalleryDetail } from "../../lib/sanity/types";

// One query for every gallery, instead of one per page.
export const getStaticPaths = (async () => {
  const galleries = await sanityFetch<GalleryDetail[]>(GALLERIES_DETAIL_QUERY, []);
  return galleries.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery } }));
}) satisfies GetStaticPaths;

interface Props {
  gallery: GalleryDetail;
}

const { gallery } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = siteTitleOf(settings);
const description = renderMarkdown(gallery.description);
const photos = gallery.photos?.filter((photo) => photo.image) ?? [];
---

<Layout
  title={`${gallery.title} — ${siteTitle}`}
  siteTitle={siteTitle}
  description={description.excerpt || undefined}
>
  <section
    class="w-full h-full pt-12 px-4 xl:px-12 flex flex-nowrap items-center flex-col-reverse xl:flex-row gap-12 overflow-y-auto"
  >
    <aside class="w-full min-h-full xl:w-1/2 flex flex-col gap-8 max-h-full overflow-y-auto pt-20 pb-12 pr-8">
      <h1 class="text-3xl font-medium">{gallery.title}</h1>
      {description.html && <div class="markdown text-lg text-neutral-900 text-justify" set:html={description.html} />}
      <ExhibitionList exhibitions={gallery.exhibitions ?? []} headingClass="text-2xl font-bold" />
    </aside>
    <section id="gallery-photos-section" class="w-full max-h-1/2 xl:max-h-full xl:h-full pb-4 pt-12">
      {
        photos.length === 0 ? (
          <p class="text-neutral-500">Cette série ne contient pas encore de photos.</p>
        ) : (
          <ul class="max-h-screen max-w-screen grow h-full shrink-0 overflow-y-auto snap-y snap-mandatory scroll-smooth gap-8">
            {photos.map((photo, index) => (
              <li class="bg-white h-full w-full space-y-3 snap-center snap-always max-h-full flex flex-col items-end justify-center">
                <figure class="h-full w-full flex flex-col items-center xl:items-end justify-center gap-2">
                  <SanityImage
                    image={photo.image!}
                    alt={photo.alt ?? photo.title ?? ""}
                    sizes="(min-width: 1280px) 50vw, 100vw"
                    priority={index === 0}
                    class="max-h-full max-w-full object-contain"
                  />
                </figure>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </section>
</Layout>

<script>
  // On mobile the photos sit below the text (flex-col-reverse): start the page on the photos.
  function resetMobileGalleryPosition() {
    if (!window.matchMedia("(max-width: 1279px)").matches) return;
    document.getElementById("gallery-photos-section")?.scrollIntoView({ block: "start" });
  }

  resetMobileGalleryPosition();
  window.addEventListener("pageshow", resetMobileGalleryPosition);
</script>
