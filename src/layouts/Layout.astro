---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Shown in the header next to the home link */
  siteTitle?: string;
}

const { title = "Portfolio", description, siteTitle = "Portfolio" } = Astro.props;

// Normalise trailing slashes (`/work/` at build time vs `/work` in dev).
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { href: "/work", label: "portfolio", active: pathname === "/work" || pathname.startsWith("/galleries/") },
  { href: "/about", label: "bio", active: pathname === "/about" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo_vr.png" />
    <link rel="apple-touch-icon" href="/logo_vr.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-jost" preload />
    <title>{title}</title>
  </head>
  <body class="h-dvh w-full antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-neutral-950"
    >
      Aller au contenu
    </a>
    <header class="fixed w-full xl:w-1/3 left-0 top-0 xl:left-8 xl:top-8 bg-white/80 backdrop-blur-xs z-50 px-4 py-2 border-b border-neutral-900 flex flex-nowrap items-center gap-8 overflow-x-auto">
      <a href="/" class="h-full flex items-center justify-center font-display text-xl tracking-tight transition mb-1">
        {siteTitle}&nbsp;/
      </a>
      <nav class="h-full grow flex flex-nowrap items-center justify-start gap-4 tracking-wider font-medium text-neutral-500">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={["transition uppercase hover:text-neutral-900", { "text-neutral-900": item.active }]}
              aria-current={item.active ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="https://shop.virgil-roger.photography"
          target="_blank"
          rel="noopener noreferrer"
          class="transition uppercase hover:text-neutral-900"
        >
          shop
        </a>
      </nav>
    </header>
    <main id="main" class="h-full w-full">
      <slot />
    </main>
  </body>
</html>
