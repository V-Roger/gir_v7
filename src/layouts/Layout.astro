---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Shown in the header next to the home link */
  siteTitle?: string;
}

const { title = "Portfolio", description, siteTitle = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="h-screen w-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-neutral-950"
    >
      Skip to content
    </a>
    <header class="fixed w-full xl:w-1/3 left-0 top-0 xl:left-8 xl:top-8 bg-white/80 backdrop-blur-xs z-50 px-4 py-2 border-b border-neutral-900 flex flex-nowrap items-center gap-8 overflow-x-auto">
      <a href="/" class="h-full flex items-center justify-center font-display text-xl tracking-tight transition mb-1">
        {siteTitle}&nbsp;/
      </a>
      <nav class="h-full grow flex flex-nowrap items-center justify-start gap-4 tracking-wider font-medium text-neutral-500">
        <a href="/work" class={`transition uppercase hover:text-neutral-900 ${Astro.url.pathname === "/work" ? "text-neutral-900" : ""}`}>portfolio</a>
        <a href="/about" class={`transition uppercase hover:text-neutral-900 ${Astro.url.pathname === "/about" ? "text-neutral-900" : ""}`}>bio</a>
        <a href="https://shop.virgil-roger.photography" target="_blank" class="transition uppercase hover:text-neutral-900">shop</a>
      </nav>
    </header>
    <main id="main" class="h-full w-full">
      <slot />
    </main>
  </body>
</html>
