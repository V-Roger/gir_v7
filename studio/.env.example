# Same project as the Astro site (sanity.io/manage → Project ID).
# Used by `pnpm dev` / `sanity deploy` in this folder.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Only for `pnpm import-galleries`: a token with Editor (write) access
# (sanity.io/manage → project → API → Tokens). Keep it out of git.
SANITY_API_WRITE_TOKEN=
